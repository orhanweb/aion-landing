# =============================================================================
# AION — Required environment variables
# =============================================================================
# Copy to .env and fill in every value. Set the same keys in Vercel → Environment Variables.
# The app fails at startup if any required value is missing or invalid.
# =============================================================================

# --- Site meta (public) ------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TAGLINE=

# --- Contact channels (public) -----------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=

# --- Assessment delivery (server-only) ---------------------------------------
# stub = log only (local dev) | email = Resend notification to NEXT_PUBLIC_CONTACT_EMAIL
ASSESSMENT_SUBMIT_MODE=
# RESEND_API_KEY=   # required when ASSESSMENT_SUBMIT_MODE=email — mark Sensitive in Vercel
