# =============================================================================
# AION — Required environment variables
# =============================================================================
# Copy to .env for local development. Set the same keys in Vercel → Settings → Environment Variables.
# The app fails at startup if any required value is missing or invalid.
# =============================================================================

# --- Site meta (public) ------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aion.tr
NEXT_PUBLIC_SITE_NAME=AION
NEXT_PUBLIC_SITE_TAGLINE=Artificial Intelligence Oversight Network

# --- Contact channels (public) -----------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=contact@aion.tr
NEXT_PUBLIC_WHATSAPP_NUMBER=+905435218694
NEXT_PUBLIC_WHATSAPP_DISPLAY=+90 (543) 521 86 94

# --- Assessment delivery (server-only) ---------------------------------------
# stub = log only (no external delivery) | webhook = POST to ASSESSMENT_WEBHOOK_URL
ASSESSMENT_SUBMIT_MODE=stub
# ASSESSMENT_WEBHOOK_URL=https://hooks.example.com/assessment
